# Mailgun (transactional email — BVC pilot signup + feedback DR archive)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Neon Postgres (Vercel marketplace). The integration auto-populates these.
# Two naming conventions exist in the wild — both are supported by lib/env.ts
# and drizzle.config.ts. Use whichever Vercel's integration creates for you.
#
#   STORAGE_DATABASE_URL{,_UNPOOLED}   — older marketplace integration
#   DATABASE_URL{,_UNPOOLED}           — newer Neon integration
#
# Pooled (pgbouncer)  → runtime queries
# Unpooled (direct)   → drizzle-kit migrate / DDL
STORAGE_DATABASE_URL=
STORAGE_DATABASE_URL_UNPOOLED=
# OR (newer Neon integration):
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# NextAuth v4 (magic-link email sign-in to /admin)
# NEXTAUTH_SECRET: generate with `openssl rand -hex 32`
# NEXTAUTH_URL: IGNORED ON VERCEL — do not reach for this to fix a redirect_uri.
#               next-auth v4's detectOrigin() returns early when process.env.VERCEL
#               is set and builds the origin from the x-forwarded-host header, so
#               NEXTAUTH_URL has no effect on any Vercel deploy (prod or preview).
#               It is read only when running OUTSIDE Vercel (e.g. local `next start`
#               behind a proxy). Because the origin comes from the request host, the
#               redirect_uri this app sends is whatever host the user browsed to —
#               www.witus.online in production. That host must be registered in
#               lib/identity/clients.ts on the IdP; setting this var cannot substitute
#               for that. See plans/25-sso-www-redirect-and-canonical-hosts.md.
# EMAIL_SERVER: SMTP URL. Mailgun example:
#   smtp://postmaster@mg.witus.online:<SMTP_PASSWORD>@smtp.mailgun.org:587
# EMAIL_FROM: must be a verified Mailgun sender on MAILGUN_DOMAIN.
# ADMIN_EMAIL: only this address is allowed to sign in (signIn callback rejects others).
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# PostHog product analytics (shared ecosystem project — see plans/26).
# Both are publishable and ship in the browser bundle; the phc_ project key is not a
# secret. PostHog labels this same value "Project API key" in Settings and "project
# token" on the snippet screen — they are one value. Never use a phx_ PERSONAL API key
# here; that one IS a secret and is not needed for capture.
#
# Capture stays entirely off until the key is set, so keyless local dev and previews
# are a supported state, not an error.
#
# The HOST must be set EXPLICITLY. The shared project is US; pointing a US key at the
# EU cluster fails SILENTLY — no error, no events, nothing to notice. This has already
# cost time once in this ecosystem.
#
# Browser traffic does not go to this host directly: next.config.ts rewrites /ingest/*
# to it, so ad blockers (uBlock, Brave, Safari) can't drop events. This value is what
# the rewrite points at, and what any server-side capture would use.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EMAIL_SERVER=
EMAIL_FROM=
ADMIN_EMAIL=

# Cloudflare Turnstile (bot protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WitUS Inbox sender (signed webhook to inbox.witus.online)
# Generate INBOX_INGEST_SECRET with: openssl rand -hex 32
# Must match the receiver's INGEST_SOURCES[<slug>].hmac_secret for this slug.
# Use distinct values per environment (prod / preview / local).
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=witus-online
INBOX_INGEST_SECRET=

# WitUS Outbox sender — podcast-publish drafts (slice C of ecosystem plan 10)
# Two podcasts, two slugs, two HMAC secrets. Each must match the outbox
# receiver's INGEST_SOURCES[<slug>] entry with workspace_name set so the
# receiver routes drafts to the right social profiles:
#   witus-online-podcast  -> B4C LLC  (BAM's personal social accounts)
#   aamsaz-podcast        -> AAMSAZ   (museum accounts)
# Generate each secret with: openssl rand -hex 32
# OUTBOX_TRIGGER_ENABLED is the master kill-switch (unset / "false" = off).
# Flip to "true" per-env only after the secrets are provisioned on both sides.
OUTBOX_INGEST_URL=https://outbox.witus.online/api/ingest
OUTBOX_TRIGGER_ENABLED=
OUTBOX_PODCAST_WFC_SLUG=witus-online-podcast
OUTBOX_PODCAST_WFC_SECRET=
OUTBOX_PODCAST_AAMSAZ_SLUG=aamsaz-podcast
OUTBOX_PODCAST_AAMSAZ_SECRET=
