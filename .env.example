# Mailgun (transactional email — BVC pilot signup + feedback DR archive)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Neon Postgres (Vercel marketplace). Both URLs come from the integration:
#   STORAGE_DATABASE_URL          pooled (pgbouncer); used at runtime
#   STORAGE_DATABASE_URL_UNPOOLED direct;             used by drizzle-kit for DDL
STORAGE_DATABASE_URL=
STORAGE_DATABASE_URL_UNPOOLED=

# NextAuth v4 (magic-link email sign-in to /admin)
# NEXTAUTH_SECRET: generate with `openssl rand -hex 32`
# NEXTAUTH_URL: canonical origin in Production (e.g. https://witus.online).
#               Leave unset in Preview to let Vercel use the deployment URL.
# EMAIL_SERVER: SMTP URL. Mailgun example:
#   smtp://postmaster@mg.witus.online:<SMTP_PASSWORD>@smtp.mailgun.org:587
# EMAIL_FROM: must be a verified Mailgun sender on MAILGUN_DOMAIN.
# ADMIN_EMAIL: only this address is allowed to sign in (signIn callback rejects others).
NEXTAUTH_SECRET=
NEXTAUTH_URL=
EMAIL_SERVER=
EMAIL_FROM=
ADMIN_EMAIL=

# Cloudflare Turnstile (bot protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WitUS Inbox sender (signed webhook to inbox.witus.online)
# Generate INBOX_INGEST_SECRET with: openssl rand -hex 32
# Must match the receiver's INGEST_SOURCES[<slug>].hmac_secret for this slug.
# Use distinct values per environment (prod / preview / local).
INBOX_INGEST_URL=https://inbox.witus.online/api/ingest
INBOX_SOURCE_SLUG=witus-online
INBOX_INGEST_SECRET=
